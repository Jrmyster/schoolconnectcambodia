{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-connect-map",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "artifacts/chuy-sala/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "schoolconnectcambodia.com",
      "custom_domain": true
    }
  ],
  "account_id": "47ca22160e0b6b6e04a019a37c5b012b"
}
