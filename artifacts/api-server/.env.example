DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_connect_map
SESSION_SECRET=replace-with-a-unique-random-secret
PORT=5000
ADMIN_EMAIL=
ADMIN_PASSWORD=

PUBLIC_SITE_URL=https://schoolconnectcambodia.com
BACKEND_PROXY_SECRET=replace-with-a-unique-random-secret-shared-with-worker

# Backend-only R2 credentials; bucket-scoped Object Read & Write permissions.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=school-connect-map-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional read-only mounted old uploads directory during migration.
LEGACY_UPLOADS_DIR=
